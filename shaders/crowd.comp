#version 460
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_shader_atomic_int64 : enable

layout(local_size_x = 256) in;

// Constants
const float MAP_MIN_LON = -10.0;
const float MAP_MIN_LAT = 35.0;
const float MAP_MAX_LON = 20.0;
const float MAP_MAX_LAT = 60.0;
const float METERS_PER_DEG_LAT = 111320.0;
const float METERS_PER_DEG_LON = 71400.0; // Approximate around 50N
const vec2 MAP_MIN = vec2(0.0, 0.0);
const vec2 MAP_MAX = vec2((MAP_MAX_LON - MAP_MIN_LON) * METERS_PER_DEG_LON,
                          (MAP_MAX_LAT - MAP_MIN_LAT) * METERS_PER_DEG_LAT);
const vec2 PARIS = vec2((-2.3522 - MAP_MIN_LON) * METERS_PER_DEG_LON,
                        (48.8566 - MAP_MIN_LAT) * METERS_PER_DEG_LAT);
const vec2 BERLIN = vec2((13.4050 - MAP_MIN_LON) * METERS_PER_DEG_LON,
                         (52.5200 - MAP_MIN_LAT) * METERS_PER_DEG_LAT);
const vec2 RED_CAPITAL = PARIS;
const vec2 BLUE_CAPITAL = BERLIN;
const float REPULSION_RADIUS = 12.0;
const float REPULSION_STRENGTH = 0.5;
const float WALK_SPEED = 1.0; // meters per second
const float MAX_VELOCITY = 1.0;
const float DAMPING = 0.98;
const float DT = 0.016; // 60 FPS
const float SPAWN_INTERVAL = 0.5; // Controls spawn rate
const float SPAWN_JITTER_RADIUS = 250.0;

struct Soldier {
    vec2 position;
    vec2 velocity;
    int team;       // 0 = Red, 1 = Blue
    int _pad;
};

layout(std430, binding = 0) buffer SoldierBuffer {
    Soldier soldiers[];
};

layout(std430, binding = 1) buffer AtomicCounterBuffer {
    uint current_active_soldiers;
};

layout(std430, binding = 2) buffer FrameBuffer {
    uint frame_counter;
};

float hash11(uint n) {
    n ^= 2747636419u;
    n *= 2654435769u;
    n ^= n >> 16;
    n *= 2654435769u;
    n ^= n >> 16;
    n *= 2654435769u;
    return float(n) / 4294967295.0;
}

vec2 spawnJitter(uint gid, uint frameSeed) {
    float angle = hash11(gid * 1664525u + frameSeed * 1013904223u) * 6.28318530718;
    float radius = sqrt(hash11(gid * 22695477u + frameSeed + 1u)) * SPAWN_JITTER_RADIUS;
    return vec2(cos(angle), sin(angle)) * radius;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    
    // Only spawn a subset per frame to avoid GPU saturation
    uint max_soldiers = min(1000000u, current_active_soldiers);
    if (gid >= max_soldiers) {
        return;
    }
    
    Soldier soldier = soldiers[gid];
    
    // === SPAWNING ===
    // If this soldier hasn't been initialized, spawn it
    if (soldier.position == vec2(0.0)) {
        soldier.team = (gid % 2u == 0u) ? 0 : 1;
        soldier.velocity = vec2(0.0);
        
        if (soldier.team == 0) {
            // Red spawns near left capital with random jitter
            soldier.position = RED_CAPITAL + spawnJitter(gid, frame_counter);
        } else {
            // Blue spawns near right capital with random jitter
            soldier.position = BLUE_CAPITAL + spawnJitter(gid ^ 0x9e3779b9u, frame_counter ^ 0x85ebca6bu);
        }
    }
    
    // === GOAL SEEKING ===
    vec2 goal = (soldier.team == 0) ? BLUE_CAPITAL : RED_CAPITAL;
    vec2 to_goal = goal - soldier.position;
    float goal_dist = length(to_goal);
    if (goal_dist > 0.0001) {
        // Use direct marching so the motion is easy to observe at 1 m/s.
        soldier.velocity = (to_goal / goal_dist) * WALK_SPEED;
    }
    
    // === REPULSION / COLLISION AVOIDANCE ===
    // Simplified: Check only nearby soldiers within a fixed radius
    vec2 repulsion = vec2(0.0);
    
    for (uint i = 0u; i < min(max_soldiers, 100u); i++) {
        if (i == gid) continue;
        
        Soldier other = soldiers[i];
        vec2 diff = soldier.position - other.position;
        float dist = length(diff);
        
        if (dist > 0.001 && dist < REPULSION_RADIUS) {
            repulsion += normalize(diff) * (1.0 - dist / REPULSION_RADIUS) * REPULSION_STRENGTH;
        }
    }
    
    soldier.velocity += repulsion * 0.25;
    
    // Clamp velocity
    float vel_mag = length(soldier.velocity);
    if (vel_mag > MAX_VELOCITY) {
        soldier.velocity = (soldier.velocity / vel_mag) * MAX_VELOCITY;
    }
    
    // === INTEGRATION ===
    soldier.position += soldier.velocity * DT;
    soldier.velocity *= DAMPING;
    
    // === BOUNDARY CONSTRAINTS ===
    soldier.position = clamp(soldier.position, MAP_MIN, MAP_MAX);
    
    // Write back
    soldiers[gid] = soldier;
}
